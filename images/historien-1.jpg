        <li><a href="/galleri">Galleri</a></li>
        <li><a href="/galleri#nyheder">Nyheder</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
      </ul>
      <p class="footer__copy">© 2026 MuBell Farm / Sandholmgaard. Alle rettigheder forbeholdes.</p>
    </div>
  </footer>

  <!-- Script -->
  <script src="js/main.js?v=12"></script>
</body>
</html>
